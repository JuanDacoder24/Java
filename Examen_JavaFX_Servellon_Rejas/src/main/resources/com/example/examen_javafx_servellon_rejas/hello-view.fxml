                    <children>
                        <Label alignment="CENTER" prefHeight="98.0" prefWidth="640.0" text="Registrar Consulta">
                            <font>
                                <Font size="32.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="FechaConsulta" layoutX="357.0" layoutY="125.0" promptText="Fecha" />
                        <TextField fx:id="HoraConsulta" layoutX="365.0" layoutY="210.0" promptText="HH:mm" />
